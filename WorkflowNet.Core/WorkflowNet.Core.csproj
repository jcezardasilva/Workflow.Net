<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>2.0.0</Version>
    <Authors>Julio Cezar da Silva</Authors>
    <Description>WorkflowNet.Core provides base objects for WorkflowNet.</Description>
